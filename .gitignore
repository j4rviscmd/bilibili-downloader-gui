# Editor directories and files
# Note: whole directory ignored — the former per-file whitelists
# (extensions.json, settings.json) were dropped with the VS Code settings
# files themselves; to share editor config again, use `.vscode/*` plus
# `!`-prefixed exceptions (gitignore cannot re-include under a dir rule).
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env

# Worktrees
.worktrees/
remotion/
plans/
docs/superpowers/

# E2E test artifacts
e2e-tests/screenshots/

# Local references (API docs, etc.)
references/

# Playwright tool artifacts (MCP session files, CLI page snapshots)
.playwright-mcp/
.playwright-cli/
# Vitest coverage output (npm run test:coverage)
coverage/
