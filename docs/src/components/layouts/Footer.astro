---
/**
 * Footer - Site footer component with copyright information.
 *
 * Displays a simple footer with the current year and copyright notice.
 */
const currentYear = new Date().getFullYear();
---

<footer class="border-t py-6">
  <div class="text-muted-foreground container mx-auto px-4 text-center text-sm">
    <p>© {currentYear} j4rviscmd</p>
  </div>
</footer>
