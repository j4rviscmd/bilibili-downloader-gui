---
/**
 * AppScreenshots - Downloads screenshot and demo video.
 *
 * The search screenshot lives in the Hero; this section shows the
 * downloads/merge screen next to the demo video. Each screenshot is a
 * lazy theme pair — only the active theme's image is ever fetched (see
 * the note inside the markup).
 */
import { getLangFromUrl, useTranslations } from "../../i18n/ui";

const url = Astro.url;
const lang = getLangFromUrl(url);
const t = useTranslations(lang);

const basePath = import.meta.env.BASE_URL;
---

<section class="container mx-auto px-4 py-8">
  <div
    class="flex flex-col items-center gap-8 md:flex-row md:items-start md:justify-center"
  >
    <div class="w-full max-w-2xl">
      <!--
        Theme pair: each <img> carries loading="lazy", and the theme-hidden
        one is display:none — a lazy image that never intersects is never
        fetched, so only the active theme's screenshot downloads.
      -->
      <img
        src={`${basePath}/app-downloads-light.webp`}
        alt={t("screenshots.downloadsAlt")}
        width="1600"
        height="869"
        loading="lazy"
        class="w-full rounded-xl border shadow-lg dark:hidden"
      />
      <img
        src={`${basePath}/app-downloads.webp`}
        alt={t("screenshots.downloadsAlt")}
        width="1600"
        height="869"
        loading="lazy"
        class="hidden w-full rounded-xl border shadow-lg dark:block"
      />
    </div>
    <div class="w-full max-w-2xl">
      <video
        id="app-demo"
        src={`${basePath}/app-demo_en.mp4`}
        class="w-full rounded-xl border shadow-lg"
        controls
        autoplay
        muted
        loop
        playsinline></video>
    </div>
  </div>
</section>
