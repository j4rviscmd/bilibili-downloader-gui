---
import GuideArticle from "../../../components/GuideArticle.astro";
import { getCollection } from "astro:content";
import { languages, type Lang } from "../../../i18n/ui";

export async function getStaticPaths() {
  // Why: en guides are generated by pages/guides/[slug].astro at the site root;
  // excluding them here avoids publishing duplicate /en/guides/* pages
  const entries = await getCollection("guides", (e) => !e.id.startsWith("en/"));
  return entries
    .map((entry) => {
      const [loc, ...rest] = entry.id.split("/");
      return {
        params: { lang: loc, slug: rest.join("/") },
        props: { entry },
      };
    })
    .filter((p) => p.params.lang in languages && p.params.lang !== "en");
}
const { entry } = Astro.props;
const { lang } = Astro.params;
---

<GuideArticle entry={entry} lang={lang as Lang} />
