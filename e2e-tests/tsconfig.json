{
  "compilerOptions": {
    // Why: target drives the default lib — wdio.local.conf.ts and the local/
    // specs use Promise.withResolvers, which the ES2022 lib does not declare
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["node", "mocha"]
  },
  "include": [
    "wdio.conf.ts",
    "wdio.local.conf.ts",
    "helpers/**/*.ts",
    "local/**/*.ts",
    "test/**/*.ts",
    "node_modules/@wdio/globals/types.d.ts",
    "node_modules/webdriverio/build/types.d.ts"
  ]
}
